# Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration (PostgreSQL - for backward compatibility)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret
JWT_SECRET=your-jwt-secret-here

# Stack Configuration (existing)
STACK_SECRET_SERVER_KEY=your-stack-secret-server-key
NUXT_PUBLIC_STACK_PROJECT_ID=your-stack-project-id
NUXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your-stack-publishable-client-key
